{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["spp/src/commands/*.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs/reference/spp",
  "plugin": ["typedoc-plugin-markdown", "./scripts/typedoc-command-tags.ts"],
  "name": "spp command reference",
  "readme": "none",
  "disableSources": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "requiredToBeDocumented": ["Module", "Variable", "Function", "TypeAlias", "Interface", "Class", "Enum", "EnumMember"],
  "validation": { "notExported": true, "invalidLink": true, "invalidPath": true, "notDocumented": true },
  "sort": ["source-order"],
  "groupOrder": ["Functions", "Variables", "Type Aliases", "*"],
  "outputFileStrategy": "modules",
  "entryFileName": "index.md",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "typeDeclarationFormat": "table"
}
