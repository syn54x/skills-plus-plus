#!/usr/bin/env bash
# Test double for gh: answers the calls of every fixture check (scripts/check-sdd.sh) from "$GH_FIXTURE" (a gh.json file).
# gh.json: { issues: {<url>: obj}, prs: {<url>: obj}, events: {"o/r#n": [...]}, comments: {"o/r#n": [...]} }
# Writes (api -X PATCH|POST, issue edit, label create) append one JSON line each to "$GH_WRITES" when it is set.
# gh.json may carry fail_after_writes: N, which makes every write after the first N fail silently with exit 1.
set -euo pipefail
F="${GH_FIXTURE:?GH_FIXTURE unset}"
W="${GH_WRITES:-/dev/null}"

POS=(); JQ=""; REPO=""; BASE=""; HEAD=""; STATE="open"; METHOD=""; FIELDS=0; BODY=""
ADD=(); REMOVE=(); BLOCKED=(); FORCE=false
while [ $# -gt 0 ]; do
  case "$1" in
    --version) echo "gh version 0.0.0-fixture"; exit 0 ;;
    --jq) JQ="$2"; shift 2 ;;
    --json|--limit|--color|--description) shift 2 ;;
    -R|--repo) REPO="$2"; shift 2 ;;
    --base) BASE="$2"; shift 2 ;;
    --head) HEAD="$2"; shift 2 ;;
    --state) STATE="$2"; shift 2 ;;
    --paginate) shift ;;
    --force) FORCE=true; shift ;;
    -X|--method) METHOD="$2"; shift 2 ;;
    -F|-f|--field|--raw-field)
      FIELDS=1
      case "$2" in
        body=@*) BODY=$(cat "${2#body=@}"; printf x); BODY=${BODY%x} ;;  # keep trailing newlines
        body=*) BODY="${2#body=}" ;;
      esac
      shift 2 ;;
    --add-label) IFS=, read -r -a V <<<"$2"; ADD+=("${V[@]}"); shift 2 ;;
    --remove-label) IFS=, read -r -a V <<<"$2"; REMOVE+=("${V[@]}"); shift 2 ;;
    --add-blocked-by) IFS=, read -r -a V <<<"$2"; BLOCKED+=("${V[@]}"); shift 2 ;;
    *) POS+=("$1"); shift ;;
  esac
done
# Like gh: a field without -X makes the call a POST.
[ -n "$METHOD" ] || { [ "$FIELDS" = 1 ] && METHOD=POST || METHOD=GET; }

miss() { echo "fixture gh: no answer for: ${POS[*]}" >&2; exit 1; }
arr() { jq -c -n '$ARGS.positional' --args "$@"; }
# True when a write should fail: the log already holds fail_after_writes lines.
injected() { local n; n=$(jq -r '.fail_after_writes // empty' "$F"); [ -n "$n" ] && [ "$(wc -l <"$W" | tr -d ' ')" -ge "$n" ]; }
reply() { if [ -n "$JQ" ]; then printf '%s' "$1" | jq -r "$JQ"; else printf '%s\n' "$1"; fi; }

if [ "${POS[0]:-}" = api ] && [ "$METHOD" != GET ]; then
  ! injected || exit 1
  jq -c -n --arg m "$METHOD" --arg p "${POS[1]}" --arg b "$BODY" '{method: $m, path: $p, body: $b}' >>"$W"
  # A PATCH names its comment id; a POST gets the write log's line count as a fresh id.
  ID="${POS[1]##*/}"
  case "$ID" in ''|*[!0-9]*) ID=$(wc -l <"$W" | tr -d ' '); [ "$ID" -gt 0 ] || ID=1 ;; esac
  reply "$(jq -c -n --argjson id "$ID" '{id: $id, html_url: "https://github.com/fixture/comment/\($id)"}')"
  exit 0
fi

case "${POS[0]} ${POS[1]:-}" in
  "issue edit")
    ! injected || exit 1
    jq -c -n --arg i "${POS[2]}" \
      --argjson a "$(arr ${ADD[@]+"${ADD[@]}"})" --argjson r "$(arr ${REMOVE[@]+"${REMOVE[@]}"})" \
      --argjson b "$(arr ${BLOCKED[@]+"${BLOCKED[@]}"})" \
      '{cmd: "issue edit", issue: $i, add_label: $a, remove_label: $r, add_blocked_by: $b}' >>"$W"
    echo "https://github.com/fixture/issues/${POS[2]##*/}"; exit 0 ;;
  "label create")
    ! injected || exit 1
    jq -c -n --arg n "${POS[2]}" --argjson f "$FORCE" '{cmd: "label create", name: $n, force: $f}' >>"$W"; exit 0 ;;
  "issue view") OUT=$(jq -c --arg u "${POS[2]}" '.issues[$u] // empty' "$F") ;;
  "pr view")    OUT=$(jq -c --arg u "${POS[2]}" '.prs[$u] // empty' "$F") ;;
  "pr list")
    OUT=$(jq -c --arg r "$REPO" --arg b "$BASE" --arg h "$HEAD" --arg s "$STATE" '
      [.prs[] | select(.url | startswith("https://github.com/\($r)/pull/"))
        | select($b == "" or .baseRefName == $b) | select($h == "" or .headRefName == $h)
        | select($s == "all" or (.state | ascii_downcase) == $s)]
      | sort_by(.url | split("/") | last | tonumber) | reverse' "$F") ;;
  api\ repos/*)
    P="${POS[1]#repos/}"; KIND="${P##*/}"; P="${P%/*}"; N="${P##*/}"; R="${P%/issues/*}"
    OUT=$(jq -c --arg k "$R#$N" --arg kind "$KIND" '.[$kind][$k] // []' "$F") ;;
  *) miss ;;
esac
[ -n "$OUT" ] || miss
reply "$OUT"
