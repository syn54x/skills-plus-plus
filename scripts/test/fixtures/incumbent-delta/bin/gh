#!/bin/sh
# Stub gh for the incumbent-delta CLI test: serves canned JSON from $GH_STUB_DIR.
case "$1 $2" in
  "issue view") cat "$GH_STUB_DIR/issue-body.txt" ;;
  "api repos/acme/alpha/releases?per_page=30") cat "$GH_STUB_DIR/alpha-releases.json" ;;
  *) echo "stub gh: unexpected $*" >&2; exit 1 ;;
esac
